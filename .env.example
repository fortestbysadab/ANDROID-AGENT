# Android Agent v2 configuration.
# Copy to .env and fill in. Never commit the real file.

# --- Telegram ---------------------------------------------------------
# From @BotFather.
ANDROID_AGENT_BOT_TOKEN=
# Your own numeric Telegram user ID (from @userinfobot). The bot accepts
# messages only from a private chat where sender ID == chat ID == this value.
ANDROID_AGENT_OWNER_CHAT_ID=

# --- Model endpoint ---------------------------------------------------
# Any service implementing POST {base}/chat/completions with tool calling.
# You may use a shorthand alias instead of a URL: gemini | openai | groq | openrouter
#
#   Google Gemini : https://generativelanguage.googleapis.com/v1beta/openai
#                   NOTE: the path must end in /v1beta/openai, not /v1beta or /v1.
#   OpenAI        : https://api.openai.com/v1
#   Local server  : http://127.0.0.1:8000/v1
ANDROID_AGENT_LLM_BASE_URL=gemini

# Must be a real model ID at that endpoint. Verify with:
#   python -m android_agent.doctor
# Gemini examples: gemini-2.5-flash, gemini-2.5-pro
ANDROID_AGENT_LLM_MODEL=gemini-2.5-flash

# Required for hosted endpoints. For Gemini use a Google AI Studio key.
ANDROID_AGENT_LLM_API_KEY=

# --- Optional ---------------------------------------------------------
# Wire-format quirks handling: openai | gemini. Auto-detected from the URL
# when unset. Gemini's function_declarations accept only a restricted
# OpenAPI 3.0 subset, so strict JSON Schema keywords are stripped outbound.
ANDROID_AGENT_LLM_DIALECT=

# Seconds to wait for a model response.
ANDROID_AGENT_LLM_TIMEOUT=60

# DEBUG | INFO | WARNING | ERROR
ANDROID_AGENT_LOG_LEVEL=INFO

# --- Conversation sessions -------------------------------------------
# The agent remembers the conversation for this many minutes of INACTIVITY,
# then starts fresh automatically. Each message resets the timer.
# Send /new to start a new conversation immediately.
ANDROID_AGENT_SESSION_TTL_MINUTES=15
# Hard cap on remembered messages; oldest whole turns are dropped first.
ANDROID_AGENT_SESSION_MAX_MESSAGES=60
# Where sessions.db, audit.jsonl and agent.log live.
ANDROID_AGENT_STATE_DIR=~/telegram_agent_v2

# --- Optional on-device fast path (experimental) ----------------------
# Uses Cactus Needle to answer simple, low-risk device commands offline
# with no API call. Requires: pip install cactus-needle
# The published wheels target glibc/musl Linux; Termux is bionic, so the
# engine may not load. If it fails the agent logs a warning and continues
# cloud-only, so enabling this can never break the bot.
ANDROID_AGENT_NEEDLE=0
ANDROID_AGENT_NEEDLE_THRESHOLD=0.85
